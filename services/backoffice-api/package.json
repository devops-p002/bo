{
  "name": "@platform/backoffice-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@platform/audit-chain": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/errors": "workspace:*",
    "@platform/ids": "workspace:*",
    "@platform/logging": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^7.9.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
